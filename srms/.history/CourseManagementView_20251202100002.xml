<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.srms.controller.CourseController">
    
    <Label text="Course Catalog Management" style="-fx-font-size: 18pt; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Course Code:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="codeField" promptText="e.g., CSCI 332" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Title:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="titleField" promptText="Desktop App Development" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Credit Hours:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="creditsField" promptText="3" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        
        <Label text="Prerequisites:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="prereqsField" promptText="CSCI 201" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Description:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextArea fx:id="descriptionArea" wrapText="true" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10.0">
        <Button text="Add Course (C)" onAction="#handleAddCourse"/>
        <Button text="Update Course (U)" onAction="#handleUpdateCourse"/>
        <Button text="Delete Course (D)" onAction="#handleDeleteCourse"/>
        <Button text="Clear Form" onAction="#handleClearForm"/>
    </HBox>

    <Label text="All Courses" style="-fx-font-weight: bold;"/>

    <TableView fx:id="courseTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="codeCol" text="Code" prefWidth="100.0"/>
            <TableColumn fx:id="titleCol" text="Title" prefWidth="300.0"/>
            <TableColumn fx:id="creditsCol" text="Credits" prefWidth="80.0"/>
            <TableColumn fx:id="prereqsCol" text="Prereqs" prefWidth="150.0"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: green; -fx-font-weight: bold;"/>

</VBox>