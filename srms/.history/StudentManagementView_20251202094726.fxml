<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.srms.controller.StudentController">
    
    <Label text="Student Records Management" style="-fx-font-size: 18pt; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Reg. Number:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="regNoField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="First Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="firstNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Last Name:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="lastNameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        
        <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Date of Birth:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dobPicker" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Department:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="departmentCombo" prefWidth="200" GridPane.rowIndex="5" GridPane.columnIndex="1">
             </ComboBox>
    </GridPane>

    <HBox spacing="10.0">
        <Button text="Add Student (C)" onAction="#handleAddStudent"/>
        <Button text="Update Student (U)" onAction="#handleUpdateStudent"/>
        <Button text="Delete Student (D)" onAction="#handleDeleteStudent"/>
        <Button text="Clear Form" onAction="#handleClearForm"/>
    </HBox>

    <Label text="All Students" style="-fx-font-weight: bold;"/>

    <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="regNoCol" text="Reg. No." prefWidth="120.0"/>
            <TableColumn fx:id="firstNameCol" text="First Name" prefWidth="120.0"/>
            <TableColumn fx:id="lastNameCol" text="Last Name" prefWidth="120.0"/>
            <TableColumn fx:id="emailCol" text="Email" prefWidth="200.0"/>
            <TableColumn fx:id="dobCol" text="D.O.B" prefWidth="100.0"/>
            <TableColumn fx:id="departmentCol" text="Department" prefWidth="150.0"/>
            <TableColumn fx:id="enrollmentDateCol" text="Enroll Date" prefWidth="100.0"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>

    <Label fx:id="statusLabel" text=""/>

</VBox>